# =============================================================================
# InternHub Monorepo — Master Environment Configuration Template
# Copy this file to `backend/.env` and `frontend/.env` (or configure via Docker)
# =============================================================================

# ─── BACKEND ENVIRONMENT VARIABLES (backend/.env) ───────────────────────────
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/internhub
CLIENT_URL=http://localhost:5173

# Authentication Secrets (minimum 64 characters recommended for security)
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_minimum_64_characters_long_for_security_internhub_dev_key
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_minimum_64_characters_long_for_security_internhub_dev_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Verification & Reset Token Lifespans
EMAIL_VERIFY_EXPIRES_IN=24
PASSWORD_RESET_EXPIRES_IN=15

# SMTP Email Configuration (Nodemailer / SendGrid / Mailtrap)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@internhub.dev
EMAIL_FROM_NAME=InternHub

# Cloudinary Storage Configuration (Optional - File uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── FRONTEND ENVIRONMENT VARIABLES (frontend/.env) ─────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=InternHub
