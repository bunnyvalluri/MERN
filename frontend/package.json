    "framer-motion": "^11.3.31",
    "lucide-react": "^0.441.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.2.3",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.53.0",
    "react-hot-toast": "^2.4.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "zod": "^3.23.8"
