# =============================================================================
# InternHub Client — Production Environment Template
# =============================================================================
# Injected into Vite at build time via hosting provider (Vercel / Cloudflare Pages).

# Canonical production REST API Gateway (must use HTTPS, no trailing slash)
VITE_API_BASE_URL=https://api.internhub.dev/api/v1

# Production branding
VITE_APP_NAME=InternHub
VITE_APP_VERSION=1.0.0
