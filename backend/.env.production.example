# =============================================================================
# InternHub Server — Production Environment Template
# =============================================================================
# DO NOT commit the actual production .env file to git repository.
# Populate these values in your cloud provider environment manager (Render/Railway/AWS).

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Canonical Frontend Domain (Strict CORS Whitelist)
# Comma-separated if multiple domains are used (e.g. root + www).
# -----------------------------------------------------------------------------
CLIENT_URL=https://internhub.dev,https://www.internhub.dev

# -----------------------------------------------------------------------------
# MongoDB Atlas Production Cluster
# Recommended: M10+ Dedicated Cluster with TLS and Replica Set enabled.
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<PRODUCTION_CLUSTER>.mongodb.net/internhub?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# Cryptographic JWT Secrets
# NEVER reuse development secrets in production!
# Minimum length: 64 characters (256-bit cryptographically secure random string).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_WITH_UNIQUE_64_CHAR_HEX_SECRET_FOR_PRODUCTION_ACCESS_TOKENS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_SECRET_FOR_PRODUCTION_REFRESH_TOKENS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Token Life Cycle (in hours / minutes)
EMAIL_VERIFY_EXPIRES_IN=24
PASSWORD_RESET_EXPIRES_IN=15

# -----------------------------------------------------------------------------
# Cloudinary Production Cloud Storage
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_production_cloud_name
CLOUDINARY_API_KEY=your_production_api_key
CLOUDINARY_API_SECRET=your_production_api_secret

# -----------------------------------------------------------------------------
# Transactional Email Dispatcher (SMTP via SendGrid / Postmark / AWS SES)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=SG.your_production_sendgrid_api_key
EMAIL_FROM=noreply@internhub.dev
EMAIL_FROM_NAME=InternHub
